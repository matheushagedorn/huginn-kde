# Generated at runtime by the theme engine
fastfetch/config.jsonc
wallust/**/generated/

# Local state
*.bak.*
*.log
__pycache__/
*.pyc

# Wallpapers are not tracked: they are third-party images and they are large.
# Put your own under ~/Pictures/Wallpapers/<Theme Name>/ and the wallpaper
# scanner picks them up. See the README.
quickshell/wallpapers/
